{
  "components": {
    "headers": {
      "ETag": {
        "description": "Opaque server-authoritative resource version. Cart runtime emission belongs to Phase 15.",
        "schema": {
          "minLength": 1,
          "type": "string"
        }
      },
      "RetryAfter": {
        "description": "Conditional retry delay emitted only when retryability is factual and no external effect is uncertain.",
        "schema": {
          "oneOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "format": "http-date",
              "type": "string"
            }
          ]
        }
      },
      "XCorrelationId": {
        "description": "Server-sanitized correlation identifier returned on every response. Invalid or missing input is replaced, never echoed arbitrarily.",
        "schema": {
          "type": "string"
        }
      }
    },
    "parameters": {
      "IdempotencyKey": {
        "description": "Server-side BFF retry identity only. It is NOT authentication, NOT authorization, NOT ownership, and NOT a capability.",
        "in": "header",
        "name": "Idempotency-Key",
        "required": true,
        "schema": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[!-~]+$",
          "type": "string"
        }
      },
      "IfMatch": {
        "description": "Opaque server-issued resource version precondition. Cart enforcement and stale 412 behavior belong to Phase 15.",
        "in": "header",
        "name": "If-Match",
        "required": true,
        "schema": {
          "minLength": 1,
          "type": "string"
        }
      },
      "XCorrelationId": {
        "description": "Optional correlation candidate. The server accepts only the closed format and replaces invalid or missing values; unsafe input is never echoed.",
        "in": "header",
        "name": "x-correlation-id",
        "required": false,
        "schema": {
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._-]{1,128}$",
          "type": "string"
        }
      }
    },
    "responses": {},
